sudo mount -t virtiofs mount_tag /path/to/guest/mountpoint


Example :

if the shared dir is in home "/home/user/SharedFiles"

mkdir -p ~/SharedFiles
sudo mount -t virtiofs "~/SharedFiles" ~/SharedFiles

in /etc/fstab

~/Sharedfile   /home/user/SharedFiles   virtiofs   defaults,nofail   0   0

~/targetpath (virt-manager)  /home/user/path  virtiofs  defaults,nofail   0   0
To test 
sudo mount -a
